# Backend environment variables (set these in the Vercel dashboard)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret
R2_BUCKET_NAME=your_bucket
R2_PUBLIC_URL=https://pub-....r2.dev

# Option 1: base64-encoded service account JSON
FIREBASE_ADMIN_KEY=base64_service_account_json
# Option 2: path to service account JSON file (for local/Vercel includeFiles)
GOOGLE_APPLICATION_CREDENTIALS=api/gestion-67-firebase-adminsdk-fbsvc-9e3650bf9b.json

ALLOWED_ORIGIN=https://bactube-67.vercel.app
